# Copiá este archivo como .env.local y completá los valores (nunca subas .env.local).
# En Vercel: Settings → Environment Variables, con estos mismos nombres.
#
# Los dos valores salen de Supabase → Project Settings → API Keys / Data API.
# Ambos son públicos por diseño (llegan al navegador) y la seguridad la da RLS.
#
# NO uses acá la clave secreta (sb_secret_… o service_role): esta app no la necesita.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
